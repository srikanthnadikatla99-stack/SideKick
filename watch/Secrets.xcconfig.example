// Copy to Secrets.xcconfig (gitignored) and fill in.
// xcconfig treats // as a comment, so split the scheme with $() as shown.
SIDEKICK_TEAM_ID = ABCDE12345
SIDEKICK_BUNDLE_ID = com.yourname.sidekick.watch
SIDEKICK_BASE_URL = https:/$()/your-tunnel.example.com
SIDEKICK_TOKEN = same-value-as-SIDEKICK_TOKEN-in-.env
