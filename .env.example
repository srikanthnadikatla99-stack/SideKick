# Source of Bee events: "live" (bee stream) or "replay" (fixtures/*.jsonl)
SIDEKICK_SOURCE=live
SIDEKICK_REPLAY_FILE=fixtures/demo.jsonl
# Replay speed multiplier (1 = real time)
SIDEKICK_REPLAY_SPEED=1

# HTTP API for the watch app. Generate the token with: openssl rand -hex 32
# Binds to localhost; expose it to the watch through an HTTPS tunnel.
SIDEKICK_HOST=127.0.0.1
SIDEKICK_PORT=8787
SIDEKICK_TOKEN=

# SQLite file for people, learned cues and follow-ups
SIDEKICK_DB=data/sidekick.db

# Path to the bee binary (defaults to the project-local @beeai/cli install)
BEE_COMMAND=

# Amazon Bedrock (credentials come from the standard AWS chain, e.g. AWS_PROFILE)
AWS_PROFILE=sidekick
AWS_REGION=us-east-1
# Nova is first-party AWS (covered by account credits); Claude may bill via Marketplace.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
